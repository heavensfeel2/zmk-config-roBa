#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp SQT>;
            key-positions = <21 17>;
        };

        left_click {
            bindings = <&mkp LCLK>;
            key-positions = <18 19>;
            layers = <0>;
        };

        right_click {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E          &kp R    &kp T                                                                      &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&mt LEFT_SHIFT A  &kp S         &kp D          &lt 4 F  &kp G        &kp TAB                                &kp MINUS              &kp H        &kp J  &kp K      &kp L    &mt RIGHT_SHIFT SEMI
&kp Z             &kp X         &kp C          &kp V    &kp B        &lt_to_layer_0 3 LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS  &kp N        &kp M  &kp COMMA  &kp DOT  &lt_to_layer_0 4 SLASH
&kp LEFT_ALT      &kp LEFT_WIN  &kp LS(LG(S))  &tog 4   &lt 2 SPACE  &mt LCTRL DEL                          &kp BACKSPACE          &lt 1 ENTER                             &lt_to_layer_0 5 LA(TILDE)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN      &kp HASH         &kp DOLLAR       &kp PERCENT                            &kp CARET        &kp AMPERSAND    &kp ASTERISK     &kp PIPE         &kp BACKSLASH
&kp KP_N1        &kp KP_NUMBER_3  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &trans       &trans   &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &lt 5 KP_NUMBER_0
&kp LA(F1)       &kp LA(F2)       &kp LA(F3)       &kp LA(F4)       &kp LA(F5)       &kp F11      &kp F12  &kp LA(F6)       &kp LA(F7)       &kp LA(F8)       &kp LA(F9)       &kp LA(F10)
&trans           &trans           &trans           &trans           &trans           &trans       &trans   &trans                                                              &kp F2
            >;
        };

        ARROW {
            bindings = <
&trans  &trans          &kp UP_ARROW    &kp HOME          &kp LESS_THAN                                 &kp GREATER_THAN   &kp END            &kp UP_ARROW    &trans           &kp ESC
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp PLUS          &bt BT_PRV      &bt BT_NXT  &kp EQUAL          &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans          &kp PAGE_UP     &kp SINGLE_QUOTE  &kp LEFT_BRACKET  &trans          &trans      &kp RIGHT_BRACKET  &kp DOUBLE_QUOTES  &kp PAGE_DOWN   &trans           &trans
&trans  &trans          &trans          &trans            &trans            &trans          &trans      &trans                                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1         &mkp MB3           &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4         &mkp MB5           &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
