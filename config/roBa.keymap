#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        henkan {
            bindings = <&henkan>;
            key-positions = <21 18>;
            layers = <0 4>;
        };

        prev_tab {
            bindings = <&kp LC(PAGE_DOWN)>;
            key-positions = <13 12>;
            layers = <0 4>;
        };

        next_tab {
            bindings = <&kp LC(PAGE_UP)>;
            key-positions = <11 12>;
            layers = <0 4>;
        };

        press_tilda {
            bindings = <&kp TILDE2>;
            key-positions = <30 33>;
            layers = <0>;
        };

        mouse_back {
            bindings = <&mkp MB4>;
            key-positions = <18 19>;
            layers = <0 4>;
        };

        mouse_next {
            bindings = <&mkp MB5>;
            key-positions = <19 20>;
            layers = <0 4>;
        };

        quot {
            bindings = <&kp SQT>;
            key-positions = <6 9>;
            layers = <0>;
        };

        Ctrl+Shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <39 41>;
            layers = <0 3 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <4 0 2 3>;
        };

        mb3Click {
            bindings = <&mkp MB3>;
            key-positions = <21 20>;
            layers = <4>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E  &kp R    &kp T                                                         &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D  &lt 4 F  &kp G        &kp TAB                   &kp MINUS              &kp H        &kp J  &kp K      &kp L    &lt_to_layer_0 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C  &kp V    &kp B        &kp LEFT_PARENTHESIS      &kp RIGHT_PARENTHESIS  &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LEFT_ALT      &kp LEFT_WIN  &to 3  &to 4    &lt 2 SPACE  &mt LCTRL DEL             &kp BACKSPACE          &lt 3 ENTER                             &mt LG(LS(S)) LG(V)
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        NUM {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                        &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp PIPE    &kp BACKSLASH
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp F2       &kp F5   &kp NUMBER_6  &kp N7         &kp N8        &kp N9      &lt 5 N0
&kp LA(F1)       &kp LA(F2)    &kp LA(F3)    &kp LA(F4)    &kp LA(F5)   &kp F11      &kp F12  &kp LA(F6)    &kp LA(F7)     &kp LA(F8)    &kp LA(F9)  &kp LA(F10)
&trans           &trans        &trans        &trans        &trans       &trans       &trans   &trans                                                 &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &kp HOME        &kp UP_ARROW    &kp LEFT_PARENTHESIS  &kp LESS_THAN                                     &kp GREATER_THAN   &kp RIGHT_PARENTHESIS  &kp UP_ARROW    &kp END          &kp ESC
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW       &kp PLUS          &kp PAGE_UP      &kp PAGE_DOWN  &kp EQUAL          &kp LEFT_ARROW         &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SEMICOLON
&trans  &trans          &kp COLON       &kp SINGLE_QUOTE      &kp LEFT_BRACKET  &trans           &trans         &kp RIGHT_BRACKET  &kp DOUBLE_QUOTES      &kp SEMI        &trans           &kp PIPE
&trans  &trans          &trans          &trans                &trans            &trans           &trans         &trans                                                                     &to 6
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&to_layer_0 Q         &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T                                                                            &to_layer_0 Y           &to_layer_0 U  &to_layer_0 I      &to_layer_0 O       &to_layer_0 P
&kp A                 &to_layer_0 S  &to_layer_0 D  &to_layer_0 F  &to_layer_0 G           &to_layer_0 TAB                   &to_layer_0 MINUS              &to_layer_0 H           &mkp MB1       &to_layer_0 K      &mkp MB2            &to_layer_0 MINUS
&mt LEFT_SHIFT Z      &to_layer_0 X  &to_layer_0 C  &to_layer_0 V  &to_layer_0 B           &to_layer_0 LEFT_PARENTHESIS      &to_layer_0 RIGHT_PARENTHESIS  &to_layer_0 N           &to_layer_0 M  &to_layer_0 COMMA  &to_layer_0 PERIOD  &mt LEFT_SHIFT SLASH
&to_layer_0 LEFT_ALT  &trans         &trans         &trans         &lt_to_layer_0 2 SPACE  &mt RCTRL DELETE                  &to_layer_0 BACKSPACE          &lt_to_layer_0 3 ENTER                                                        &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans        &trans        &trans        &trans        &trans                                 &bt BT_CLR  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans       &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &bootloader  &trans      &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans       &trans                              &trans
            >;
        };
    };
};
